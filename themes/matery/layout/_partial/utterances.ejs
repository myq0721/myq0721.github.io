<style>
    .utterances-card .card-content {
        padding: 20px;
    }
    .utterances-card .utterances {
        max-width: 100%;
    }
</style>

<div class="card utterances-card" data-aos="fade-up">
    <div class="comment_headling" style="font-size: 20px; font-weight: 700; position: relative; padding-left: 20px; top: 15px; padding-bottom: 5px;">
        <i class="fas fa-comments fa-fw" aria-hidden="true"></i>
        <span>评论</span>
    </div>
    <div class="card-content">
        <script src="https://utteranc.es/client.js"
            repo="<%- theme.utterances.repo %>"
            issue-term="<%- theme.utterances.issueTerm %>"
            theme="<%- theme.utterances.theme %>"
            <% if (theme.utterances.label) { %>label="<%- theme.utterances.label %>"<% } %>
            crossorigin="anonymous"
            async>
        </script>
    </div>
</div>
